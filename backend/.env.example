# Copy to `.env` for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
API_VERSION=v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/direct_college?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret-abc
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret-xyz

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API with credentials (Next.js on Vercel).
CORS_ORIGIN=http://localhost:3000

# Optional: share cookies across subdomains.
# COOKIE_DOMAIN=.yourdomain.com

# Set true behind HTTPS in production when frontend and API are on different sites.
# COOKIE_SECURE=true

# Google Web Client ID used to verify ID tokens from the Next.js app.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

BCRYPT_ROUNDS=12

# Optional: Python FastAPI ML stack (see `src/ml-services/mlGateway.ts`)
# ML_SERVICE_URL=http://127.0.0.1:8000
# ML_SERVICE_API_KEY=
# ML_SERVICE_TIMEOUT_MS=15000
# ML_SERVICE_MAX_RETRIES=2

# BullMQ worker options (run workers: npm run worker)
# ENABLE_WORKERS=false
# ENABLE_QUEUE_CRON=false

# Optional: directory for scrape HTML/PDF snapshots
# SCRAPE_STORAGE_DIR=./data/scrape-snapshots
